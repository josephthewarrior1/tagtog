# Copy to .env. Use your own admin email and a unique password (at least 12 characters).
# This creates the first admin only. Subsequent password changes use the reset CLI.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# A separate PostgreSQL container and volume for TagTog. No public database port.
# Set a different, unique database password before starting Docker Compose.
POSTGRES_DB=tagtog
POSTGRES_USER=tagtog
POSTGRES_PASSWORD=

# Origin includes the scheme, with no trailing slash.
PUBLIC_ORIGIN=https://tagtog.id,https://www.tagtog.id
COOKIE_SECURE=true

# Apache runs on the host and forwards to this local port.
TAGTOG_BIND_IP=127.0.0.1
TAGTOG_PORT=8787

# For local Docker testing instead:
# PUBLIC_ORIGIN=http://localhost:8787,http://127.0.0.1:8787
# COOKIE_SECURE=false
